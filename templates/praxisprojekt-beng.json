{
  "id": "tpl_pp",
  "workspace": "ws_hs",
  "name": "Praxisprojekt (B.Eng.)",
  "definition": {
    "roles": [
      {
        "key": "supervisor",
        "label": "Erstprüfer:in",
        "access": "case_owner"
      },
      {
        "key": "student",
        "label": "Studierende:r",
        "access": "guest_contributor"
      },
      {
        "key": "company",
        "label": "Zweitprüfer:in (Unternehmen)",
        "access": "guest_contributor"
      },
      {
        "key": "office",
        "label": "Studienbüro",
        "access": "guest_viewer"
      }
    ],
    "fields": [
      {
        "key": "student",
        "label": "Name der/des Studierenden"
      },
      {
        "key": "matrikel",
        "label": "Matrikelnummer"
      },
      {
        "key": "programme",
        "label": "Studiengang (z. B. B. Eng. Elektrotechnik)"
      },
      {
        "key": "company_name",
        "label": "Unternehmen/Institution"
      },
      {
        "key": "second_examiner",
        "label": "Zweitprüfer:in"
      },
      {
        "key": "project_title",
        "label": "Projekttitel"
      },
      {
        "key": "po",
        "label": "Prüfungsordnung (PO-Version)"
      },
      {
        "key": "start",
        "label": "Angestrebter Start",
        "type": "date"
      },
      {
        "key": "end",
        "label": "Angestrebte Abgabe",
        "type": "date"
      }
    ],
    "due_base_field": "start",
    "document_types": [
      {
        "key": "expose",
        "label": "Exposé",
        "visible_to": [
          "student",
          "company"
        ]
      },
      {
        "key": "laufzettel",
        "label": "Antrag auf Zulassung zur Praxisphase",
        "visible_to": [
          "student",
          "company",
          "office"
        ]
      },
      {
        "key": "report",
        "label": "Ausarbeitung",
        "visible_to": [
          "student",
          "company"
        ]
      },
      {
        "key": "ossc",
        "label": "OSSC-Anmeldung",
        "visible_to": [
          "student"
        ]
      },
      {
        "key": "slides",
        "label": "Präsentationsfolien",
        "visible_to": [
          "student",
          "company"
        ]
      },
      {
        "key": "result",
        "label": "Bewertung der Praxisphase",
        "visible_to": [
          "office"
        ]
      }
    ],
    "phases": [
      {
        "title": "Thema & Exposé",
        "tasks": [
          {
            "key": "topic",
            "title": "Thema, Unternehmen und Zweitprüfer:in klären",
            "type": "task",
            "role": "student",
            "description": "Welches Thema? Welche:r Dozent:in betreut es? Welches Unternehmen hat Interesse? Ihre Ansprechperson im Unternehmen wird Zweitprüfer:in. Fragen an den Prüfungssupport: pruefung.ei@hs-duesseldorf.de"
          },
          {
            "key": "expose",
            "title": "Exposé hochladen",
            "type": "upload",
            "role": "student",
            "doc_type": "expose",
            "after": [
              "topic"
            ],
            "description": "Bitte die Exposé-Vorlage verwenden: https://dl.proto-hess.com/PeHd2W2k – mit Thema, Existenzgrund, Ziel, Forschungsfragen, Vorgehensweise, Evaluation und Zeitplan (Arbeitspakete, Meilensteine). Als PDF hochladen."
          },
          {
            "key": "expose_review",
            "title": "Exposé prüfen",
            "type": "review",
            "role": "supervisor",
            "after": [
              "expose"
            ],
            "visible_to": [
              "student"
            ]
          }
        ]
      },
      {
        "title": "Anmeldung",
        "tasks": [
          {
            "key": "form",
            "title": "Antrag auf Zulassung ausfüllen und unterschreiben",
            "type": "upload",
            "role": "student",
            "doc_type": "laufzettel",
            "after": [
              "expose_review"
            ],
            "description": "NomoCase erzeugt den Antrag vorausgefüllt („Formular … herunterladen“). In einem PDF-Reader wie Adobe Acrobat ergänzen (Studiengang, PO-Version, bisherige Versuche), digital unterschreiben und hier hochladen; die Prüfer:innen unterschreiben danach in derselben Datei. Das offizielle Formular des Fachbereichs (Stand 08.09.2026) geht weiterhin: https://ei.hs-duesseldorf.de/studium/pruefungsangelegenheiten/formulare/Documents/FB%20EI_Antrag_Praxisphase_080926.pdf – Das Thema wird genau so ins Zeugnis übernommen.",
            "form": "zulassung"
          },
          {
            "key": "sign_company",
            "title": "Antrag unterschreiben (Zweitprüfer:in)",
            "type": "signature",
            "role": "company",
            "doc_type": "laufzettel",
            "after": [
              "form"
            ],
            "visible_to": [
              "student"
            ],
            "description": "Mit Ihrer Unterschrift bestätigen Sie, dass Sie das Praxisprojekt als Prüfer:in betreuen und mindestens den entsprechenden Abschluss oder eine gleichwertige Qualifikation haben (§ 9 Abs. 2–3 RahmenPO EI). Unterschriebene PDF hochladen. Bei externer Betreuung darf ausnahmsweise die/der Erstprüfer:in im Auftrag unterschreiben und bestätigt damit Ihre Qualifikation."
          },
          {
            "key": "sign_supervisor",
            "title": "Antrag unterschreiben (Erstprüfer:in)",
            "type": "signature",
            "role": "supervisor",
            "doc_type": "laufzettel",
            "after": [
              "sign_company"
            ],
            "visible_to": [
              "student",
              "company"
            ],
            "description": "Das Datum dieser Unterschrift gilt als Projektstart; die Bearbeitungszeit beträgt mindestens 8 Wochen."
          },
          {
            "key": "copy",
            "title": "Antrag an pruefung.ei@hs-duesseldorf.de senden",
            "type": "submission",
            "role": "student",
            "after": [
              "sign_supervisor"
            ],
            "description": "Den vollständig unterschriebenen Antrag umgehend an pruefung.ei@hs-duesseldorf.de senden. Das Studienbüro prüft die Voraussetzungen, die/der Prüfungsausschussvorsitzende lässt zu; das dauert je nach Aufkommen 2–3 Wochen. Danach steht die Anmeldung im eCampus und es kommt eine Bestätigung per E-Mail (FAQ Praxisphase, Stand 01.09.2026)."
          }
        ]
      },
      {
        "title": "Durchführung",
        "tasks": [
          {
            "key": "work",
            "title": "Praxisprojekt durchführen (mindestens 8 Wochen)",
            "type": "task",
            "role": "student",
            "after": [
              "sign_supervisor"
            ],
            "visible_to": [
              "company"
            ]
          }
        ]
      },
      {
        "title": "Abgabe & Prüfung",
        "tasks": [
          {
            "key": "report",
            "title": "Ausarbeitung bei den Prüfer:innen einreichen",
            "type": "upload",
            "role": "student",
            "doc_type": "report",
            "after": [
              "work"
            ],
            "due_field": "end",
            "visible_to": [
              "company"
            ],
            "description": "Ausarbeitung als PDF, mit unterschriebener eidesstattlicher Versicherung, dass Sie sie selbstständig und ohne unzulässige fremde Hilfe erstellt haben (§ 10 Abs. 6 RahmenPO EI)."
          },
          {
            "key": "ossc",
            "title": "Im OSSC zur Prüfung anmelden",
            "type": "upload",
            "role": "student",
            "doc_type": "ossc",
            "after": [
              "report"
            ],
            "description": "Online im OSSC anmelden und den Nachweis (Ausdruck) als PDF hochladen. Die Präsentation ist frühestens zwei Wochen nach der Anmeldung möglich; den Nachweis zum Termin mitbringen."
          },
          {
            "key": "talk_date",
            "title": "Präsentationstermin vereinbaren",
            "type": "task",
            "role": "supervisor",
            "after": [
              "ossc"
            ],
            "visible_to": [
              "student",
              "company"
            ]
          },
          {
            "key": "talk",
            "title": "Präsentation halten",
            "type": "upload",
            "role": "student",
            "doc_type": "slides",
            "after": [
              "talk_date"
            ],
            "visible_to": [
              "company"
            ],
            "description": "Vortrag vor beiden Prüfer:innen; die Folien als PDF hochladen."
          },
          {
            "key": "grade_1",
            "title": "Bewerten (Erstprüfer:in)",
            "type": "approval",
            "role": "supervisor",
            "after": [
              "talk"
            ],
            "labels": [
              "Bestanden",
              "Nicht bestanden"
            ]
          },
          {
            "key": "grade_2",
            "title": "Bewerten (Zweitprüfer:in)",
            "type": "approval",
            "role": "company",
            "after": [
              "talk"
            ],
            "labels": [
              "Bestanden",
              "Nicht bestanden"
            ]
          },
          {
            "key": "result",
            "title": "Bewertung ans Studienbüro senden",
            "type": "submission",
            "role": "supervisor",
            "doc_type": "result",
            "after": [
              "grade_1",
              "grade_2"
            ],
            "visible_to": [
              "student",
              "office"
            ],
            "description": "NomoCase erzeugt die Bewertung (Seite 2 des Antrags) vorausgefüllt: ankreuzen, ob der Vortrag gehalten, die Ausarbeitung abgegeben und die Praxisphase bestanden wurde; beide Prüfer:innen unterschreiben. Zeitnah ans Studienbüro. Ist das Ergebnis gemeldet, aber noch nicht verbucht, kann die/der Studierende die Thesis schon anmelden – mit einem Hinweis darauf in der Begleitmail (FAQ Praxisphase).",
            "form": "bewertung"
          }
        ]
      },
      {
        "title": "Verbuchung",
        "tasks": [
          {
            "key": "booked",
            "title": "Verbuchung durch das Studienbüro",
            "type": "wait",
            "role": "supervisor",
            "after": [
              "result"
            ],
            "visible_to": [
              "student",
              "office"
            ]
          }
        ]
      }
    ],
    "rules": [
      {
        "id": "projektstart",
        "name": "Projektstart mitteilen",
        "trigger": "document.uploaded",
        "conditions": [
          {
            "field": "task.key",
            "operator": "equals",
            "value": "sign_supervisor"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "visible_to": [
              "*"
            ],
            "text": "Der Antrag ist vollständig unterschrieben: Das Praxisprojekt startet heute ({date}). Die Bearbeitungszeit beträgt mindestens 8 Wochen, die Ausarbeitung kann also frühestens am {date+56} eingereicht werden. Bitte den Antrag jetzt an pruefung.ei@hs-duesseldorf.de senden; die Zulassung durch den Prüfungsausschuss dauert 2–3 Wochen."
          }
        ]
      },
      {
        "id": "ossc",
        "name": "Frühesten Präsentationstermin mitteilen",
        "trigger": "document.uploaded",
        "conditions": [
          {
            "field": "document.type",
            "operator": "equals",
            "value": "ossc"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "visible_to": [
              "*"
            ],
            "text": "Die OSSC-Anmeldung liegt vor. Die Präsentation ist frühestens am {date+14} möglich; bitte den Nachweis zum Termin mitbringen."
          }
        ]
      },
      {
        "id": "nicht_bestanden",
        "name": "Bei „Nicht bestanden“ Gespräch anlegen",
        "trigger": "task.reject",
        "conditions": [
          {
            "field": "task.key",
            "operator": "in",
            "value": [
              "grade_1",
              "grade_2"
            ]
          }
        ],
        "actions": [
          {
            "type": "create_task",
            "title": "Gespräch zum Ergebnis führen",
            "task_type": "task",
            "assign_to_role": "owner",
            "visible_to": [
              "student"
            ],
            "description": "Mindestens eine Bewertung lautet „Nicht bestanden“. Weiteres Vorgehen mit der/dem Studierenden besprechen."
          }
        ]
      },
      {
        "id": "verbucht",
        "name": "Abschluss mitteilen",
        "trigger": "task.complete",
        "conditions": [
          {
            "field": "task.key",
            "operator": "equals",
            "value": "booked"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "visible_to": [
              "student"
            ],
            "text": "Ihr Praxisprojekt ist verbucht. Herzlichen Glückwunsch!"
          }
        ]
      }
    ],
    "forms": [
      {
        "key": "zulassung",
        "title": "Antrag auf Zulassung zur Praxisphase",
        "subtitle": "Von beiden Prüfer/innen unterschrieben an pruefung.ei@hs-duesseldorf.de senden. Über die Zulassung entscheidet die/der Prüfungsausschussvorsitzende.",
        "items": [
          {
            "heading": "Persönliche Angaben"
          },
          {
            "label": "Name, Vorname",
            "value": "{field.student}",
            "half": true
          },
          {
            "label": "Matrikelnummer",
            "value": "{field.matrikel}",
            "half": true
          },
          {
            "label": "Studiengang",
            "value": "{field.programme}",
            "half": true
          },
          {
            "label": "PO-Version",
            "value": "{field.po}",
            "half": true
          },
          {
            "label": "E-Mail-Adresse",
            "value": "{role.student.email}"
          },
          {
            "heading": "Thema der Praxisphase"
          },
          {
            "label": "Thema – wird in dieser Fassung ins Zeugnis übernommen",
            "value": "{field.project_title}",
            "lines": 3
          },
          {
            "heading": "Erklärung der/des Studierenden"
          },
          {
            "label": "Bisherige Versuche der Praxisphase",
            "value": "0",
            "half": true
          },
          {
            "text": "Hiermit versichere ich, dass ich die in der für mich gültigen Prüfungsordnung genannten Voraussetzungen zur Anmeldung der Praxisphase erfülle. Ich versichere, die vorstehenden Angaben vollständig und wahrheitsgemäß gemacht zu haben, und bitte um Zulassung zur Praxisphase."
          },
          {
            "sign": "Unterschrift der/des Studierenden",
            "name": "{field.student}",
            "place": "Düsseldorf"
          },
          {
            "heading": "Prüfer/innen"
          },
          {
            "label": "Erstprüfer/in – Professor/in des Fachbereichs EI",
            "value": "{role.supervisor}"
          },
          {
            "text": "Mit meiner Unterschrift bestätige ich, dass ich die o. g. Praxisphase als Erstprüfer/in betreue."
          },
          {
            "sign": "Unterschrift Erstprüfer/in",
            "name": "{role.supervisor}",
            "place": "Düsseldorf"
          },
          {
            "label": "Zweitprüfer/in – mit vollständigem Titel",
            "value": "{field.second_examiner}"
          },
          {
            "text": "Mit meiner Unterschrift bestätige ich, dass ich die o. g. Praxisphase als Zweitprüfer/in betreue. Bei externer Betreuung darf ausnahmsweise die/der Erstprüfer/in im Auftrag unterschreiben und bestätigt damit zugleich, dass die/der Zweitprüfer/in die zur Bewertung erforderliche Qualifikation hat."
          },
          {
            "sign": "Unterschrift Zweitprüfer/in",
            "name": "{field.second_examiner}",
            "place": "Düsseldorf"
          },
          {
            "heading": "Externe Durchführung",
            "hint": "Nur in einer Firma oder an einem Institut"
          },
          {
            "label": "Name der Firma / des Instituts",
            "value": "{field.company_name}"
          },
          {
            "label": "Kontaktdaten der/des Betreuer/in",
            "lines": 2
          },
          {
            "heading": "Zulassung",
            "hint": "Von der Hochschule auszufüllen"
          },
          {
            "label": "Die vorstehenden Angaben werden bestätigt.",
            "check": true
          },
          {
            "sign": "Unterschrift Studienbüro"
          },
          {
            "label": "Zur Praxisphase zugelassen",
            "check": true,
            "half": true
          },
          {
            "label": "Nicht zugelassen",
            "check": true,
            "half": true
          },
          {
            "sign": "Unterschrift Prüfungsausschussvorsitzende/r"
          }
        ]
      },
      {
        "key": "bewertung",
        "title": "Bewertung der Praxisphase",
        "subtitle": "Von beiden Prüfer/innen unterschrieben zeitnah an das Studienbüro.",
        "items": [
          {
            "heading": "Persönliche Angaben"
          },
          {
            "label": "Name, Vorname",
            "value": "{field.student}",
            "half": true
          },
          {
            "label": "Matrikelnummer",
            "value": "{field.matrikel}",
            "half": true
          },
          {
            "label": "Studiengang",
            "value": "{field.programme}",
            "half": true
          },
          {
            "label": "PO-Version",
            "value": "{field.po}",
            "half": true
          },
          {
            "label": "Thema der Praxisphase",
            "value": "{field.project_title}",
            "lines": 2
          },
          {
            "heading": "Ergebnis",
            "hint": "Jeweils ja oder nein ankreuzen"
          },
          {
            "label": "Der Vortrag wurde gehalten: ja",
            "check": true,
            "half": true
          },
          {
            "label": "Der Vortrag wurde gehalten: nein",
            "check": true,
            "half": true
          },
          {
            "label": "Die Ausarbeitung wurde abgegeben: ja",
            "check": true,
            "half": true
          },
          {
            "label": "Die Ausarbeitung wurde abgegeben: nein",
            "check": true,
            "half": true
          },
          {
            "label": "Die Praxisphase wurde bestanden: ja",
            "check": true,
            "half": true
          },
          {
            "label": "Die Praxisphase wurde bestanden: nein",
            "check": true,
            "half": true
          },
          {
            "heading": "Prüfer/innen"
          },
          {
            "label": "Erstprüfer/in",
            "value": "{role.supervisor}"
          },
          {
            "sign": "Unterschrift Erstprüfer/in",
            "name": "{role.supervisor}",
            "place": "Düsseldorf"
          },
          {
            "label": "Zweitprüfer/in",
            "value": "{field.second_examiner}"
          },
          {
            "sign": "Unterschrift Zweitprüfer/in",
            "name": "{field.second_examiner}",
            "place": "Düsseldorf"
          }
        ]
      }
    ]
  }
}
