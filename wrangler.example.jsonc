// Copy to wrangler.jsonc (kept out of git) and fill in your domain, mail addresses and database id.
{
  "name": "nomocase",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  // Smaller to parse on every cold start (low traffic: most requests start a fresh instance); maps keep stack traces readable.
  "minify": true,
  "upload_source_maps": true,
  "assets": { "directory": "./public" },
  // One canonical origin: passkeys are bound to the hostname, so a second URL would need second passkeys.
  "workers_dev": false,
  // The former domain stays attached only to send old links (mails, bookmarks) on to the canonical one (REDIRECT_HOSTS).
  "routes": [{ "pattern": "nomocase.example.org", "custom_domain": true }],
  // Mail goes out via Resend; the API key is the secret RESEND_API_KEY (wrangler secret put).
  // INBOX_DOMAIN: case addresses v-<inbox>@… (Cloudflare Email Routing, catch-all → this Worker). Unset = no case mail.
  "vars": { "ORIGIN": "https://nomocase.example.org", "MAIL_FROM": "NomoCase <noreply@nomocase.example.org>", "REDIRECT_HOSTS": "",
    "INBOX_DOMAIN": "example.org",
    // Shown in the consent text (public/shared/consent.js): who operates NomoCase, whom to contact about data protection.
    "OPERATOR": "[Betreiber – bitte eintragen]", "PRIVACY_CONTACT": "[Kontakt Datenschutz – bitte eintragen]" },
  // Both stores are restricted to the EU jurisdiction (GDPR: health and university data).
  "d1_databases": [{ "binding": "DB", "database_name": "nomocase", "database_id": "<id from: wrangler d1 create nomocase --jurisdiction eu>" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "nomocase-files", "jurisdiction": "eu" }],
  // Keep the Worker's console output (e.g. failed mails) for later reading in the dashboard (Workers Logs).
  "observability": { "enabled": true },
  // Id of the deployed version: open pages notice a new deployment and reload (otherwise a tab keeps running old code).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Requests without a session to login, invitation and upload links: at most 30 a minute per address and endpoint.
  "ratelimits": [{ "name": "PUBLIC_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // progress mails every 20 minutes; retention + daily digest at 05:00 UTC (06:00/07:00 in Germany)
  "triggers": { "crons": ["*/20 * * * *", "0 5 * * *"] }
}
